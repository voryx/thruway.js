{
  // ESM build: dist/esm/**, built by `node node_modules/typescript7/bin/tsc -p tsconfig.build.json`.
  "extends": "./tsconfig.src.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist/esm",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,
    "stripInternal": true
  },
  "include": ["src/**/*.ts"]
}
