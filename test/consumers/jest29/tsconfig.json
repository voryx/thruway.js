{
  // Lint-only project for the plain-JS Jest tests (typescript-eslint's projectService needs one): types come from
  // src (paths) and a minimal declaration of @jest/globals; the tests themselves run untyped under Jest 29.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "paths": {
      "thruway.js": ["../../../src/index.ts"],
      "thruway.js/testing": ["../../../src/testing/index.ts"],
      "thruway.js/rxjs": ["../../../src/rxjs/index.ts"],
      "@jest/globals": ["./jest-globals.d.cts"],
      "rxjs": ["../../../node_modules/rxjs5/Rx.d.ts"]
    }
  },
  "include": ["*.test.cjs", "jest-globals.d.cts"]
}
